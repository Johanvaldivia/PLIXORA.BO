rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función de seguridad: solo el administrador autorizado puede acceder
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email == 'admin@plixora.bo';
    }

    // Ventas
    match /plixora_sales/{doc} {
      allow read, write: if isAdmin();
    }

    // Contactos
    match /plixora_contacts/{doc} {
      allow read, write: if isAdmin();
    }

    // Cuentas de Netflix con credenciales
    match /netflix_accounts/{doc} {
      allow read, write: if isAdmin();
    }

    // Cuentas grupales (prime, disney, spotify, etc.)
    match /group_accounts/{doc} {
      allow read, write: if isAdmin();
    }

    // Planes y combos personalizados
    match /plixora_custom_plans/{doc} {
      allow read, write: if isAdmin();
    }

    // Rechazar cualquier otra ruta no autorizada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}